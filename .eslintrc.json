{
    "env": {
        "browser": true,
        "es2022": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-undef": "warn",
        "no-console": "warn",
        "no-debugger": "warn",
        "prefer-const": "warn",
        "no-var": "warn",
        "semi": ["error", "always"],
        "quotes": ["warn", "single"],
        "indent": ["warn", 4]
    },
    "ignorePatterns": [
        "admin/assets/",
        "node_modules/"
    ]
}
